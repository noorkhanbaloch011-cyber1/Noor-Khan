{% comment %}
  Renders SVG icons based on the 'name' parameter.
  Usage: {% render 'icon', name: 'cart' %}
{% endcomment %}

{% case name %}
  {% when 'cart' %}
    <svg xmlns="http://www.w3.org/2000/svg" class="icon-svg w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
    </svg>
  {% when 'search' %}
    <svg xmlns="http://www.w3.org/2000/svg" class="icon-svg w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
  {% when 'user' %}
    <svg xmlns="http://www.w3.org/2000/svg" class="icon-svg w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
    </svg>
  {% when 'leaf' %}
    <svg xmlns="http://www.w3.org/2000/svg" class="icon-svg w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21V11m0 0a4 4 0 014-4h1.5a4 4 0 014 4v1.5a4 4 0 01-4 4H12m0-6.5a4 4 0 00-4-4H6.5a4 4 0 00-4 4v1.5a4 4 0 004 4H12" />
    </svg>
  {% when 'close' %}
    <svg xmlns="http://www.w3.org/2000/svg" class="icon-svg w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  {% when 'arrow-right' %}
    <svg xmlns="http://www.w3.org/2000/svg" class="icon-svg w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  {% when 'heart' %}
    <svg xmlns="http://www.w3.org/2000/svg" class="icon-svg w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
    </svg>
  {% when 'spa' %}
    <svg xmlns="http://www.w3.org/2000/svg" class="icon-svg w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 3c-1.5 3-4 6-8 7 4 1 6.5 4 8 7 1.5-3 4-6 8-7-4-1-6.5-4-8-7z"/>
    </svg>
  {% else %}
    <!-- default icon fallback -->
    <span></span>
{% endcase %}
