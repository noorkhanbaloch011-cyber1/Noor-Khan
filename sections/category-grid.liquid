      <a class="group category-ring flex flex-col items-center" href="#category-cleansers">
        <div class="category-img-container">
          <img alt="Cleansers" src="https://lh3.googleusercontent.com/aida-public/AB6AXuA9Q6EKwGCCBoGf_M7w3DScThFyTCQ4BiltZETVjuBeOw8INfyeXE5DGpWGS-16BVFQzNaBEJYhWnwY-3mf-uPV-E0MLfAw79rpdwzpuUJg8zhOCsBGXKjpHT22sD7gjsZqK1gOD-Iy-pp0ehOPZpHGk0-NBZOF9dqORRNx0vIgLdqn5XV2RDELUtA69sGcEqhmV9HnJ6eNf8824FsYT1o8hZvtHMFVIE41UAmWPoKn-KsxzhIr3GpX4A" loading="lazy" />
