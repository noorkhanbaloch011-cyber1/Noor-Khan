<!-- Shop by Category Section -->
<section class="py-12 max-w-7xl mx-auto px-4 sm:px-8 text-center" data-purpose="category-section" id="shop">
  <!-- Section Heading with decorative arrows -->
  <div class="flex items-center justify-center space-x-4 mb-10">
    <span class="h-[1px] w-12 bg-slate-300"></span>
    <h2 class="text-xs sm:text-sm tracking-[0.25em] font-bold text-[#146868] uppercase">
      {{ section.settings.heading | default: 'Shop by Category' }}
    </h2>
    <span class="h-[1px] w-12 bg-slate-300"></span>
  </div>

  <!-- Categories Grid (6 circular tiles) -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-6 sm:gap-8">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <a class="group category-ring flex flex-col items-center" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="category-img-container">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.title | escape }}" loading="lazy" />
            {%- elsif block.settings.fallback_asset != blank -%}
              <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" />
            {%- else -%}
              {%- case forloop.index -%}
                {%- when 1 -%}<img src="{{ 'category-serums.jpg' | asset_url }}" alt="Serums" loading="lazy" />
                {%- when 2 -%}<img src="{{ 'category-moisturizers.jpg' | asset_url }}" alt="Moisturizers" loading="lazy" />
                {%- when 3 -%}<img src="{{ 'category-cleansers.jpg' | asset_url }}" alt="Cleansers" loading="lazy" />
                {%- when 4 -%}<img src="{{ 'category-toners.jpg' | asset_url }}" alt="Toners" loading="lazy" />
                {%- when 5 -%}<img src="{{ 'category-eyecare.jpg' | asset_url }}" alt="Eye Care" loading="lazy" />
                {%- when 6 -%}<img src="{{ 'category-suncare.jpg' | asset_url }}" alt="Sun Care" loading="lazy" />
                {%- else -%}<img src="{{ 'category-serums.jpg' | asset_url }}" alt="Category" loading="lazy" />
              {%- endcase -%}
            {%- endif -%}
          </div>
          <h3 class="category-title">{{ block.settings.title }}</h3>
          <span class="category-subtitle">{{ 'products.product.explore' | t | default: 'Explore' }}</span>
        </a>
      {%- endfor -%}
    {%- else -%}
      <!-- Default 6 Categories -->
      <a class="group category-ring flex flex-col items-center" href="#category-serums">
        <div class="category-img-container">
          <img alt="Serums" src="{{ 'category-serums.jpg' | asset_url }}" loading="lazy" />
        </div>
        <h3 class="category-title">Serums</h3>
        <span class="category-subtitle">Explore</span>
      </a>

      <a class="group category-ring flex flex-col items-center" href="#category-moisturizers">
        <div class="category-img-container">
          <img alt="Moisturizers" src="{{ 'category-moisturizers.jpg' | asset_url }}" loading="lazy" />
        </div>
        <h3 class="category-title">Moisturizers</h3>
        <span class="category-subtitle">Explore</span>
      </a>

      <a class="group category-ring flex flex-col items-center" href="#category-cleansers">
        <div class="category-img-container">
          <img alt="Cleansers" src="{{ 'category-cleansers.jpg' | asset_url }}" loading="lazy" />
        </div>
        <h3 class="category-title">Cleansers</h3>
        <span class="category-subtitle">Explore</span>
      </a>

      <a class="group category-ring flex flex-col items-center" href="#category-toners">
        <div class="category-img-container">
          <img alt="Toners" src="{{ 'category-toners.jpg' | asset_url }}" loading="lazy" />
        </div>
        <h3 class="category-title">Toners</h3>
        <span class="category-subtitle">Explore</span>
      </a>

      <a class="group category-ring flex flex-col items-center" href="#category-eyecare">
        <div class="category-img-container">
          <img alt="Eye Care" src="{{ 'category-eyecare.jpg' | asset_url }}" loading="lazy" />
        </div>
        <h3 class="category-title">Eye Care</h3>
        <span class="category-subtitle">Explore</span>
      </a>

      <a class="group category-ring flex flex-col items-center" href="#category-suncare">
        <div class="category-img-container">
          <img alt="Sun Care" src="{{ 'category-suncare.jpg' | asset_url }}" loading="lazy" />
        </div>
        <h3 class="category-title">Sun Care</h3>
        <span class="category-subtitle">Explore</span>
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop by Category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Serums"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "fallback_image_url",
          "label": "Fallback Image URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category"
    }
  ]
}
{% endschema %}
