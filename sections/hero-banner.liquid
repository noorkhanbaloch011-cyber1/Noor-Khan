{%- liquid
  assign bg_image = 'hero-banner-clean-desktop.jpg' | asset_url
  if section.settings.hero_bg_image != blank
    assign bg_image = section.settings.hero_bg_image | image_url: width: 2000
  endif
-%}

<!-- Hero Banner Section (Unified Seamless Canvas matching Image 2) -->
<section 
  class="relative text-white overflow-hidden pb-16 md:pb-24 hero-banner-unified" 
  data-purpose="hero-banner"
  style="background-image: url('{{ bg_image }}'); background-size: cover; background-position: right center; background-repeat: no-repeat; background-color: #317b79;"
>
  <!-- Background Ambient Glow Overlay -->
  <div class="absolute inset-0 glow-overlay pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-14 sm:py-20 md:py-24 lg:py-28 relative z-10 min-h-[460px] sm:min-h-[520px] lg:min-h-[580px] flex items-center">
    <!-- Hero Text Content (Positioned over clean gradient left area) -->
    <div class="w-full max-w-lg lg:max-w-xl space-y-5 sm:space-y-6 text-left">
      <div class="inline-flex items-center space-x-2 text-teal-100 tracking-[0.25em] text-xs font-bold uppercase">
        <i class="fa-solid fa-leaf text-teal-200"></i>
        <span>{{ section.settings.eyebrow | default: 'Naturally Radiant' }}</span>
      </div>

      <h1 class="font-playfair text-3xl sm:text-5xl lg:text-6xl font-normal leading-[1.12] text-white drop-shadow-sm">
        {{ section.settings.heading_line1 | default: 'Skincare' }} <br/>
        {{ section.settings.heading_line2 | default: 'that cares,' }} <br/>
        {{ section.settings.heading_line3 | default: 'beauty that' }} <br/>
        <span class="italic font-playfair font-medium text-teal-100">{{ section.settings.heading_italic | default: 'shines.' }}</span>
      </h1>

      <!-- Delicate decorative flourish -->
      <div class="flex items-center space-x-3 text-teal-200/60 max-w-xs pt-1">
        <span class="h-[1px] w-10 bg-teal-200/40"></span>
        <i class="fa-solid fa-seedling text-xs"></i>
        <span class="h-[1px] w-10 bg-teal-200/40"></span>
      </div>

      <p class="text-teal-50/90 text-xs sm:text-sm lg:text-base max-w-sm sm:max-w-md font-light leading-relaxed">
        {{ section.settings.subheading | default: 'Discover the perfect blend of nature and science for healthy, glowing skin every day.' }}
      </p>

      <!-- Action Buttons -->
      <div class="pt-3 flex flex-wrap items-center gap-4">
        <a class="inline-flex items-center space-x-3 bg-[#146868] hover:bg-[#095855] text-white px-7 py-3.5 rounded-full font-semibold text-xs tracking-wider uppercase border border-white/20 shadow-lg hover:shadow-teal-900/40 transition-all-custom" href="{{ section.settings.btn_link | default: '#featured-products' }}">
          <span>{{ section.settings.btn_label | default: 'Shop Now' }}</span>
          <i class="fa-solid fa-arrow-right-long text-sm"></i>
        </a>

        {%- if section.settings.show_video_btn -%}
          <button type="button" class="inline-flex items-center space-x-3 text-white hover:text-teal-100 px-4 py-3 rounded-full text-xs font-semibold tracking-wider uppercase group transition" onclick="openVideoModal()">
            <span class="w-8 h-8 rounded-full border border-teal-200/60 flex items-center justify-center group-hover:border-white transition">
              <i class="fa-solid fa-play text-[10px] ml-0.5 text-teal-100 group-hover:text-white"></i>
            </span>
            <span>{{ section.settings.video_btn_label | default: 'Watch Video' }}</span>
          </button>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Naturally Radiant"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading Line 1",
      "default": "Skincare"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading Line 2",
      "default": "that cares,"
    },
    {
      "type": "text",
      "id": "heading_line3",
      "label": "Heading Line 3",
      "default": "beauty that"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading Italic Word",
      "default": "shines."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover the perfect blend of nature and science for healthy, glowing skin every day."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "show_video_btn",
      "label": "Show Watch Video Button",
      "default": true
    },
    {
      "type": "text",
      "id": "video_btn_label",
      "label": "Video Button Label",
      "default": "Watch Video"
    },
    {
      "type": "image_picker",
      "id": "hero_bg_image",
      "label": "Custom Hero Background Image"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
