<!-- Featured Products Section -->
<section class="py-12 max-w-7xl mx-auto px-4 sm:px-8" data-purpose="featured-products-grid" id="featured-products">
  <!-- Section Header with Title and 'View All' CTA -->
  <div class="flex items-center justify-between mb-8">
    <h2 class="font-playfair text-2xl sm:text-3xl font-bold text-[#146868] flex items-center gap-3">
      {{ section.settings.heading | default: 'Featured Products' }}
      <span class="h-[1px] w-12 bg-slate-300 inline-block"></span>
    </h2>
    <a class="text-xs font-bold tracking-widest text-[#146868] hover:text-teal-700 border border-[#146868]/30 px-4 py-2 rounded-full uppercase transition" href="{{ section.settings.view_all_link | default: '/collections/all' }}">
      {{ 'general.view_all' | t | default: 'View All' }}
    </a>
  </div>

  <!-- 4-Column Product Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {%- assign target_collection = collections[section.settings.collection] -%}
    {%- if target_collection != blank and target_collection.products_count > 0 -%}
      {%- for product in target_collection.products limit: section.settings.products_to_show -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      <!-- Product 1: Best Seller - Hydra Glow Gel Cream -->
      {% render 'product-card',
        badge_text: 'Best Seller',
        title: 'Hydra Glow Gel Cream',
        price: 3400,
        rating: 5,
        reviews_count: 245,
        image_asset: 'product-1.jpg'
      %}

      <!-- Product 2: New - Radiance Boost Serum -->
      {% render 'product-card',
        badge_text: 'New',
        title: 'Radiance Boost Serum',
        price: 4200,
        rating: 5,
        reviews_count: 189,
        image_asset: 'product-2.jpg'
      %}

      <!-- Product 3: Limited - Nourishing Night Restorative Cream -->
      {% render 'product-card',
        badge_text: 'Limited',
        title: 'Nourishing Night Restorative Cream',
        price: 3800,
        rating: 5,
        reviews_count: 312,
        image_asset: 'product-3.jpg'
      %}

      <!-- Product 4: Sale - Daily UV Defense Sunscreen SPF 50 -->
      {% render 'product-card',
        badge_text: 'Sale',
        title: 'Daily UV Defense Sunscreen SPF 50',
        price: 2400,
        compare_price: 3000,
        rating: 4.5,
        reviews_count: 156,
        image_asset: 'product-4.jpg'
      %}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
