<!-- Promotional Club & Newsletter Banner -->
<section class="py-12 max-w-7xl mx-auto px-4 sm:px-8" data-purpose="promo-club-banner">
  <div class="bg-[#0b3c39] rounded-3xl overflow-hidden text-white shadow-xl grid grid-cols-1 lg:grid-cols-12 items-center">
    <!-- Left Product Showcase Image -->
    <div class="lg:col-span-4 h-64 lg:h-full relative min-h-[220px]">
      {%- if section.settings.image != blank -%}
        <img alt="{{ section.settings.image.alt | default: 'Skincare serums and cream jars' | escape }}" class="w-full h-full object-cover" src="{{ section.settings.image | image_url: width: 800 }}" loading="lazy" />
      {%- else -%}
        <img alt="Skincare serums and cream jars on stone display" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBprMJtnc9JxdqI-Rj4awdfyJuB1byrdqdmh4X75KeGCX8Xzv8uSZQUH7S-8npqWlUFcE3C0EnkFQVUA41chryu941sPvkkKfTpKbUPykGUDLPyH-P4KLHJY-r55pEpXrke6yK85ZQgOzSgd5EfYlSzpl5duGolETzCAoYKryt8duP_wFDZi_UaEqyMSxGx84-dtpBVCUTfYjFZGzpgQ4R0dcpGVUlNuuXDgGM4VBficLfY0qYw5jxn8w" loading="lazy" />
      {%- endif -%}
      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-[#0b3c39]/30 to-[#0b3c39]"></div>
    </div>

    <!-- Middle: Promo Headline -->
    <div class="lg:col-span-5 p-6 sm:p-10 space-y-2">
      <span class="text-[11px] font-bold tracking-[0.25em] text-teal-300 uppercase">
        {{ section.settings.eyebrow | default: 'Special Offer' }}
      </span>
      <h2 class="font-playfair text-3xl sm:text-4xl font-normal leading-tight">
        {{ section.settings.title | default: 'Get 20% Off<br/>Your First Order' }}
      </h2>
      <p class="text-teal-200/80 text-xs sm:text-sm font-light pt-1">
        {{ section.settings.subtitle | default: 'Join our glow club & unlock exclusive offers and skincare tips.' }}
      </p>
    </div>

    <!-- Right: Newsletter Signup Form Box -->
    <div class="lg:col-span-3 p-6 sm:p-8 bg-[#08302e] lg:h-full flex flex-col justify-center border-t lg:border-t-0 lg:border-l border-teal-800/50">
      <div class="flex items-center space-x-3 mb-3">
        <div class="w-8 h-8 rounded-full bg-[#114b47] flex items-center justify-center text-teal-300 text-sm">
          <i class="fa-regular fa-envelope"></i>
        </div>
        <span class="font-bold text-xs tracking-widest uppercase">
          {{ section.settings.form_title | default: 'Join Now' }}
        </span>
      </div>
      <p class="text-[11px] text-teal-200/70 mb-4 leading-relaxed">
        {{ section.settings.form_text | default: 'Be the first to know about new arrivals & exclusive deals.' }}
      </p>

      {% form 'customer', class: 'space-y-2.5', onsubmit: "event.preventDefault(); showToast('Welcome to the Glow Club! Check your email for 20% off.'); this.reset();" %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input 
          class="w-full px-3 py-2 bg-[#12423f] border border-teal-700/60 rounded text-xs text-white placeholder-teal-300/50 focus:outline-none focus:border-teal-300" 
          placeholder="{{ 'newsletter.placeholder' | t | default: 'Enter your email' }}" 
          required 
          type="email" 
          name="contact[email]"
        />
        <button class="w-full bg-teal-300 hover:bg-teal-200 text-[#08302e] font-bold text-xs py-2 rounded uppercase tracking-wider transition" type="submit">
          {{ 'newsletter.button_label' | t | default: 'Subscribe' }}
        </button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo Club Banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Special Offer"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Get 20% Off<br/>Your First Order"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Join our glow club & unlock exclusive offers and skincare tips."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Showcase Image"
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Form Heading",
      "default": "Join Now"
    },
    {
      "type": "text",
      "id": "form_text",
      "label": "Form Subtext",
      "default": "Be the first to know about new arrivals & exclusive deals."
    }
  ],
  "presets": [
    {
      "name": "Promo Club Banner"
    }
  ]
}
{% endschema %}
