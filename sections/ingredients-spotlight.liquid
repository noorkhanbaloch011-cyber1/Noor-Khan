<!-- Clean Ingredients Spotlight Section -->
<section class="py-16 max-w-7xl mx-auto px-4 sm:px-8" data-purpose="ingredients-spotlight-section" id="ingredients">
  <div class="text-center max-w-2xl mx-auto mb-12">
    <div class="inline-flex items-center space-x-2 text-teal-700 bg-teal-50 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider mb-3">
      <i class="fa-solid fa-seedling text-teal-600"></i>
      <span>{{ section.settings.eyebrow | default: 'Pure Botanical Actives' }}</span>
    </div>
    <h2 class="font-playfair text-3xl sm:text-4xl font-bold text-[#146868] mb-3">
      {{ section.settings.heading | default: 'Powered by Nature, Elevated by Science' }}
    </h2>
    <p class="text-sm text-slate-500 leading-relaxed">
      {{ section.settings.subheading | default: 'We harness biocompatible plant extracts and dermatological actives that work with your skin biology, never against it.' }}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <!-- Ingredient 1 -->
    <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
      <div>
        <div class="w-12 h-12 rounded-xl bg-teal-50 text-[#146868] flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-droplet"></i>
        </div>
        <div class="text-[10px] uppercase font-bold tracking-widest text-teal-700 mb-1">Deep Hydration</div>
        <h3 class="font-playfair font-bold text-lg text-slate-900 mb-2">Triple Hyaluronic Acid</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Three molecular weights penetrate surface, mid, and deep dermal layers to attract and bind 1,000x its weight in moisture.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] font-semibold text-slate-700">
        Found in: <span class="text-teal-700">Hydra Glow Gel Cream</span>
      </div>
    </div>

    <!-- Ingredient 2 -->
    <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
      <div>
        <div class="w-12 h-12 rounded-xl bg-teal-50 text-[#146868] flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-sun"></i>
        </div>
        <div class="text-[10px] uppercase font-bold tracking-widest text-teal-700 mb-1">Illuminating Actives</div>
        <h3 class="font-playfair font-bold text-lg text-slate-900 mb-2">Niacinamide 5%</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Vitamin B3 visibly tightens enlarged pores, balances excess oil production, and fades post-blemish discoloration.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] font-semibold text-slate-700">
        Found in: <span class="text-teal-700">Radiance Boost Serum</span>
      </div>
    </div>

    <!-- Ingredient 3 -->
    <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
      <div>
        <div class="w-12 h-12 rounded-xl bg-teal-50 text-[#146868] flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-shield-heart"></i>
        </div>
        <div class="text-[10px] uppercase font-bold tracking-widest text-teal-700 mb-1">Barrier Healing</div>
        <h3 class="font-playfair font-bold text-lg text-slate-900 mb-2">Centella Asiatica (Cica)</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Centuries-old healing herb rich in madecassoside that cools burning sensations, soothes redness, and speeds barrier repair.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] font-semibold text-slate-700">
        Found in: <span class="text-teal-700">Nourishing Night Cream</span>
      </div>
    </div>

    <!-- Ingredient 4 -->
    <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
      <div>
        <div class="w-12 h-12 rounded-xl bg-teal-50 text-[#146868] flex items-center justify-center text-xl mb-4">
          <i class="fa-solid fa-leaf"></i>
        </div>
        <div class="text-[10px] uppercase font-bold tracking-widest text-teal-700 mb-1">Antioxidant Guard</div>
        <h3 class="font-playfair font-bold text-lg text-slate-900 mb-2">Green Tea Polyphenols</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Potent EGCG bio-flavonoids neutralize free radical damage caused by UV exposure, smog, and daily blue light.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-100 text-[11px] font-semibold text-slate-700">
        Found in: <span class="text-teal-700">Daily UV Shield SPF 50</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredients Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Pure Botanical Actives"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Powered by Nature, Elevated by Science"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We harness biocompatible plant extracts and dermatological actives."
    }
  ],
  "presets": [
    {
      "name": "Ingredients Spotlight"
    }
  ]
}
{% endschema %}
