<!-- 5-Step Skincare Routine Section -->
<section class="py-16 max-w-7xl mx-auto px-4 sm:px-8" data-purpose="skincare-routine-section" id="routine">
  <div class="text-center max-w-2xl mx-auto mb-12">
    <div class="inline-flex items-center space-x-2 text-teal-700 bg-teal-50 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider mb-3">
      <i class="fa-solid fa-sparkles text-teal-600"></i>
      <span>{{ section.settings.eyebrow | default: 'Your Daily Ritual' }}</span>
    </div>
    <h2 class="font-playfair text-3xl sm:text-4xl font-bold text-[#146868] mb-3">
      {{ section.settings.heading | default: 'The 5-Step Glow Routine' }}
    </h2>
    <p class="text-sm text-slate-500 leading-relaxed">
      {{ section.settings.subheading | default: 'Carefully curated botanical steps designed to work in synergy for deep cellular hydration and radiant glow.' }}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-all flex flex-col justify-between" {{ block.shopify_attributes }}>
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold font-playfair text-teal-700 bg-teal-50 px-2.5 py-1 rounded-full">
                Step 0{{ forloop.index }}
              </span>
              <div class="w-8 h-8 rounded-full bg-slate-50 text-[#146868] flex items-center justify-center text-xs">
                <i class="fa-solid fa-leaf"></i>
              </div>
            </div>

            <div class="w-full aspect-square bg-[#f1f8f5] rounded-xl overflow-hidden mb-4 flex items-center justify-center p-3">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.step_name | escape }}" class="max-h-28 object-contain" loading="lazy" />
              {%- else -%}
                <img src="{{ block.settings.fallback_image }}" alt="{{ block.settings.step_name | escape }}" class="max-h-28 object-contain" loading="lazy" />
              {%- endif -%}
            </div>

            <h3 class="font-playfair font-bold text-base text-slate-900 mb-1.5">
              {{ block.settings.step_name }}
            </h3>
            <p class="text-xs text-slate-500 leading-relaxed mb-4">
              {{ block.settings.step_desc }}
            </p>
          </div>

          <a href="{{ block.settings.link | default: '#featured-products' }}" class="text-[11px] font-bold tracking-wider text-teal-700 hover:text-teal-900 flex items-center space-x-1 uppercase pt-2 border-t border-slate-100">
            <span>Shop Step</span>
            <i class="fa-solid fa-arrow-right text-[10px]"></i>
          </a>
        </div>
      {%- endfor -%}
    {%- else -%}
      <!-- Default 5 Steps -->
      <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold font-playfair text-teal-700 bg-teal-50 px-2.5 py-1 rounded-full">Step 01</span>
            <span class="text-slate-400 text-xs uppercase font-bold">Cleanse</span>
          </div>
          <div class="w-full aspect-square bg-[#f1f8f5] rounded-xl overflow-hidden mb-4 flex items-center justify-center p-3">
            <img src="{{ 'category-cleansers.jpg' | asset_url }}" alt="Cleanse" class="max-h-28 object-contain" />
          </div>
          <h3 class="font-playfair font-bold text-base text-slate-900 mb-1.5">Gentle Purifying Cleanser</h3>
          <p class="text-xs text-slate-500 leading-relaxed mb-4">Removes impurities and pollutants while protecting the delicate skin barrier.</p>
        </div>
        <a href="#featured-products" class="text-[11px] font-bold tracking-wider text-teal-700 hover:text-teal-900 flex items-center space-x-1 uppercase pt-2 border-t border-slate-100">
          <span>Shop Step</span><i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>

      <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold font-playfair text-teal-700 bg-teal-50 px-2.5 py-1 rounded-full">Step 02</span>
            <span class="text-slate-400 text-xs uppercase font-bold">Tone</span>
          </div>
          <div class="w-full aspect-square bg-[#f1f8f5] rounded-xl overflow-hidden mb-4 flex items-center justify-center p-3">
            <img src="{{ 'category-toners.jpg' | asset_url }}" alt="Tone" class="max-h-28 object-contain" />
          </div>
          <h3 class="font-playfair font-bold text-base text-slate-900 mb-1.5">Balancing Floral Toner</h3>
          <p class="text-xs text-slate-500 leading-relaxed mb-4">Restores natural skin pH balance and readies skin for deep serum penetration.</p>
        </div>
        <a href="#featured-products" class="text-[11px] font-bold tracking-wider text-teal-700 hover:text-teal-900 flex items-center space-x-1 uppercase pt-2 border-t border-slate-100">
          <span>Shop Step</span><i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>

      <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold font-playfair text-teal-700 bg-teal-50 px-2.5 py-1 rounded-full">Step 03</span>
            <span class="text-slate-400 text-xs uppercase font-bold">Treat</span>
          </div>
          <div class="w-full aspect-square bg-[#f1f8f5] rounded-xl overflow-hidden mb-4 flex items-center justify-center p-3">
            <img src="{{ 'product-2.jpg' | asset_url }}" alt="Treat" class="max-h-28 object-contain" />
          </div>
          <h3 class="font-playfair font-bold text-base text-slate-900 mb-1.5">Radiance Boost Serum</h3>
          <p class="text-xs text-slate-500 leading-relaxed mb-4">Concentrated botanical antioxidants that brighten dullness and smooth texture.</p>
        </div>
        <a href="#featured-products" class="text-[11px] font-bold tracking-wider text-teal-700 hover:text-teal-900 flex items-center space-x-1 uppercase pt-2 border-t border-slate-100">
          <span>Shop Step</span><i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>

      <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold font-playfair text-teal-700 bg-teal-50 px-2.5 py-1 rounded-full">Step 04</span>
            <span class="text-slate-400 text-xs uppercase font-bold">Moisturize</span>
          </div>
          <div class="w-full aspect-square bg-[#f1f8f5] rounded-xl overflow-hidden mb-4 flex items-center justify-center p-3">
            <img src="{{ 'product-1.jpg' | asset_url }}" alt="Moisturize" class="max-h-28 object-contain" />
          </div>
          <h3 class="font-playfair font-bold text-base text-slate-900 mb-1.5">Hydra Glow Gel Cream</h3>
          <p class="text-xs text-slate-500 leading-relaxed mb-4">Locks in 72-hour moisture with lightweight hyaluronic acid and aloe vera.</p>
        </div>
        <a href="#featured-products" class="text-[11px] font-bold tracking-wider text-teal-700 hover:text-teal-900 flex items-center space-x-1 uppercase pt-2 border-t border-slate-100">
          <span>Shop Step</span><i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>

      <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold font-playfair text-teal-700 bg-teal-50 px-2.5 py-1 rounded-full">Step 05</span>
            <span class="text-slate-400 text-xs uppercase font-bold">Protect</span>
          </div>
          <div class="w-full aspect-square bg-[#f1f8f5] rounded-xl overflow-hidden mb-4 flex items-center justify-center p-3">
            <img src="{{ 'product-4.jpg' | asset_url }}" alt="Protect" class="max-h-28 object-contain" />
          </div>
          <h3 class="font-playfair font-bold text-base text-slate-900 mb-1.5">Daily UV Shield SPF 50</h3>
          <p class="text-xs text-slate-500 leading-relaxed mb-4">Broad-spectrum mineral UVA/UVB shield without white cast or pore-clogging grease.</p>
        </div>
        <a href="#featured-products" class="text-[11px] font-bold tracking-wider text-teal-700 hover:text-teal-900 flex items-center space-x-1 uppercase pt-2 border-t border-slate-100">
          <span>Shop Step</span><i class="fa-solid fa-arrow-right text-[10px]"></i>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Skincare Routine Steps",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Your Daily Ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The 5-Step Glow Routine"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Carefully curated botanical steps designed to work in synergy for deep cellular hydration and radiant glow."
    }
  ],
  "blocks": [
    {
      "type": "routine_step",
      "name": "Routine Step",
      "settings": [
        {
          "type": "text",
          "id": "step_name",
          "label": "Step Title",
          "default": "Gentle Purifying Cleanser"
        },
        {
          "type": "textarea",
          "id": "step_desc",
          "label": "Step Description",
          "default": "Removes impurities while protecting the skin barrier."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Product Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Product Image"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Fallback Image URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Skincare Routine Steps"
    }
  ]
}
{% endschema %}
