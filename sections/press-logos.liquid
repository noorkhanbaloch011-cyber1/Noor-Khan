<!-- Press / Featured In Logos Section -->
<section class="py-6 bg-white border-b border-slate-100" data-purpose="press-logos-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 opacity-75 grayscale hover:grayscale-0 transition-all duration-300">
      <span class="text-[11px] font-bold tracking-[0.25em] text-slate-400 uppercase text-center md:text-left">
        {{ section.settings.title | default: 'Featured In & Praised By' }}
      </span>
      <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12 text-slate-700">
        <span class="font-serif text-lg sm:text-xl tracking-widest font-black">VOGUE</span>
        <span class="font-serif text-lg sm:text-xl tracking-wider font-bold italic">ELLE</span>
        <span class="font-serif text-base sm:text-lg tracking-widest uppercase font-semibold">Harper's BAZAAR</span>
        <span class="font-sans text-lg sm:text-xl tracking-widest font-black uppercase">allure</span>
        <span class="font-serif text-lg sm:text-xl tracking-wider font-bold uppercase">GLAMOUR</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Press Logos",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured In & Praised By"
    }
  ],
  "presets": [
    {
      "name": "Press Logos"
    }
  ]
}
{% endschema %}
