<!-- Main Collection Section -->
<section class="py-12 max-w-7xl mx-auto px-4 sm:px-8" data-purpose="main-collection">
  <div class="mb-8 text-center">
    <h1 class="font-playfair text-3xl sm:text-4xl font-bold text-[#146868] mb-2">
      {{ collection.title | default: 'All Skincare Formulations' }}
    </h1>
    {%- if collection.description != blank -%}
      <p class="text-sm text-slate-500 max-w-xl mx-auto">{{ collection.description }}</p>
    {%- else -%}
      <p class="text-sm text-slate-500 max-w-xl mx-auto">Nourish, protect, and illuminate your complexion with pure botanical actives.</p>
    {%- endif -%}
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {%- if collection.products.size > 0 -%}
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      <!-- Fallback cards -->
      {% render 'product-card',
        badge_text: 'Best Seller',
        title: 'Hydra Glow Gel Cream',
        price: 3400,
        rating: 5,
        reviews_count: 245,
        image_asset: 'product-1.jpg'
      %}
      {% render 'product-card',
        badge_text: 'New',
        title: 'Radiance Boost Serum',
        price: 4200,
        rating: 5,
        reviews_count: 189,
        image_asset: 'product-2.jpg'
      %}
      {% render 'product-card',
        badge_text: 'Limited',
        title: 'Nourishing Night Restorative Cream',
        price: 3800,
        rating: 5,
        reviews_count: 312,
        image_asset: 'product-3.jpg'
      %}
      {% render 'product-card',
        badge_text: 'Sale',
        title: 'Daily UV Defense Sunscreen SPF 50',
        price: 2400,
        compare_price: 3000,
        rating: 4.5,
        reviews_count: 156,
        image_asset: 'product-4.jpg'
      %}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "settings": []
}
{% endschema %}
